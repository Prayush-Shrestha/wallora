# =================================================================
# WALLORA CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# Works with Supabase, Neon, Railway, or local PostgreSQL
# -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/wallora?schema=public"

# -----------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth)
# Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------
# 3. IMAGE STORAGE (Cloudinary OR Cloudflare R2)
# -----------------------------------------------------------------
# Option A: Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Option B: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# -----------------------------------------------------------------
# 4. AI IMAGE GENERATION (Replicate or Custom API)
# -----------------------------------------------------------------
REPLICATE_API_TOKEN=""
REPLICATE_MODEL_VERSION="black-forest-labs/flux-schnell"

# -----------------------------------------------------------------
# 5. PUBLIC NEXT.JS VARS
# -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
