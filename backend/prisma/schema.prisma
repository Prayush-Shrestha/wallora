datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  profileImage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  wallpapers   Wallpaper[]
  favorites    Favorite[]
  downloads    Download[]
  aiWallpapers AIWallpaper[]

  @@map("users")
}

model Wallpaper {
  id           String        @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  width        Int           @default(1920)
  height       Int           @default(1080)
  orientation  String        @default("landscape") // portrait | landscape | square | ultrawide
  deviceType   String        @default("desktop")   // phone | tablet | laptop | desktop | ultrawide
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isAI         Boolean       @default(false)
  downloads    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  favorites       Favorite[]
  downloadRecords Download[]

  @@index([categoryId])
  @@index([orientation])
  @@index([deviceType])
  @@map("wallpapers")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  wallpapers  Wallpaper[]

  @@map("categories")
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, wallpaperId])
  @@map("favorites")
}

model Download {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("downloads")
}

model AIWallpaper {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt      String
  style       String?
  orientation String?
  resolution  String?
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@map("ai_wallpapers")
}
