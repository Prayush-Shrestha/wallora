datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  profileImage String?
  role         String        @default("USER") // USER | ADMIN
  status       String        @default("ACTIVE") // ACTIVE | SUSPENDED
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  wallpapers    Wallpaper[]
  favorites     Favorite[]
  downloads     Download[]
  aiWallpapers  AIWallpaper[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("users")
}

model Wallpaper {
  id           String        @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  width        Int           @default(1920)
  height       Int           @default(1080)
  orientation  String        @default("landscape") // portrait | landscape | square | ultrawide
  deviceType   String        @default("desktop")   // phone | tablet | laptop | desktop | ultrawide
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId     String?
  author       User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isAI         Boolean       @default(false)
  downloads    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  favorites       Favorite[]
  downloadRecords Download[]

  @@index([categoryId])
  @@index([orientation])
  @@index([deviceType])
  @@map("wallpapers")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  image       String?
  wallpapers  Wallpaper[]

  @@map("categories")
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, wallpaperId])
  @@map("favorites")
}

model Download {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  wallpaperId String
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@map("downloads")
}

model AIWallpaper {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  prompt      String
  style       String?
  orientation String?
  resolution  String?
  imageUrl    String
  createdAt   DateTime  @default(now())

  @@map("ai_wallpapers")
}

model Plan {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // free | pro-monthly | pro-yearly
  description String?
  priceCents  Int      @default(0)
  currency    String   @default("USD")
  interval    String   @default("NONE") // NONE | MONTH | YEAR
  features    String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@map("plans")
}

model Subscription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan      @relation(fields: [planId], references: [id])
  status            String    @default("ACTIVE") // ACTIVE | CANCELED | EXPIRED | PAST_DUE
  provider          String    @default("MANUAL") // MANUAL | STRIPE | ...
  providerRef       String?
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents    Int
  currency       String    @default("USD")
  status         String    @default("COMPLETED") // PENDING | COMPLETED | FAILED | REFUNDED
  provider       String    @default("MANUAL")
  providerRef    String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("payments")
}
