# ── Server ─────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3002

# ── Database (PostgreSQL) ──────────────────────────────
# Local Docker (docker compose up -d db):
DATABASE_URL="postgresql://postgres:password@localhost:5432/wallora?schema=public"
# Hosted options: Supabase, Neon, Railway — paste the connection string they give you.

# ── Auth ───────────────────────────────────────────────
# Use a long random string in production (32+ chars).
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── Cloudinary (optional) ──────────────────────────────
# Leave blank to store uploads in backend/uploads instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── AI image providers (optional) ──────────────────────
# Empty tokens are fine — the free Flux engine works with no key.
REPLICATE_API_TOKEN=""
OPENAI_API_KEY=""
