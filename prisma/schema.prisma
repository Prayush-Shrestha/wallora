datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// NextAuth / Auth.js Models
// ----------------------------------------------------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  password      String?      // For credentials email/password authentication
  role          String       @default("user") // "user" | "admin"
  
  accounts      Account[]
  sessions      Session[]
  wallpapers    Wallpaper[]
  favorites     Favorite[]
  creations     AICreation[]
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------
// Wallora Domain Models (Wallpapers, Categories, Favorites)
// ----------------------------------------------------

model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  preview     String?
  wallpapers  Wallpaper[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Wallpaper {
  id           String      @id @default(cuid())
  title        String
  image        String      // Cloudinary / Cloudflare R2 / External URL
  thumbnail    String
  categorySlug String
  category     Category?   @relation(fields: [categoryId], references: [id])
  categoryId   String?
  
  tags         String[]    // Native PostgreSQL array
  author       String
  authorAvatar String?
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  width        Int
  height       Int
  orientation  String      // "portrait" | "landscape" | "square" | "ultrawide"
  device       String[]    // ["phone", "laptop", "desktop", "tablet", "ultrawide"]
  downloads    Int         @default(0)
  likes        Int         @default(0)
  isAI         Boolean     @default(false)
  colors       String[]
  featured     Boolean     @default(false)
  
  favorites    Favorite[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([categorySlug])
  @@index([orientation])
  @@index([featured])
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  wallpaperId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallpaper   Wallpaper @relation(fields: [wallpaperId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())

  @@unique([userId, wallpaperId])
  @@index([userId])
}

model AICreation {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  image       String
  prompt      String
  style       String?
  orientation String?
  resolution  String?
  seed        String?
  
  createdAt   DateTime  @default(now())
  
  @@index([userId])
}
